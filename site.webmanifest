{
  "name": "3D Submit Resizer",
  "short_name": "3D Resizer",
  "description": "Crop and resize 3D print photos for Thingiverse, Printables and MakerWorld.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
